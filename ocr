}  {:>8}\".format(\"段落数\", o[\"段落\"], r[\"段落\"]))\n    print(\"  {:>10}  {:>8}  {:>8}  {:>5.0f}%\".format(\"字数\", o[\"字数\"], r[\"字数\"], coverage))\n    print(\"  {:>10}  {:>8}  {:>8}\".format(\"表格数\", o[\"表数\"], r[\"表数\"]))\n    print(\"  {:>10}  {:>8}  {:>8}  {:>5.0f}%\".format(\"表文字\", o[\"表文字\"], r[\"表文字\"],\n        o[\"表文字\"]/r[\"表文字\"]*100 if r[\"表文字\"] else 0))\n    print(\"  {:>10}  {:>8}  {:>8}\".format(\"字号(中)\", str(o[\"字号(中位)\"]), str(r[\"字号(中位)\"])))\n    \n    # 前5段对比\n    ocr_first = [p.text.strip()[:60] for p in ocr.paragraphs if p.text.strip()][:3]\n    ref_first = [p.text.strip()[:60] for p in ref.paragraphs if p.text.strip()][:3]\n    print(\"  OCR前3段:\")\n    for t in ocr_first:\n        print(\"    {}\".format(t))\n    print(\"  参考前3段:\")\n    for t in ref_first:\n        print(\"    {}\".format(t))\n"
